{
  "name": "youtube-dashboard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/start-dev.cjs",
    "build": "npm run lint && vite build",
    "test": "vitest run",
    "demo": "node scripts/preview-fixture.cjs",
    "test:launcher": "node --test scripts/launch-dashboard.test.cjs scripts/dashboard-lifecycle.test.cjs",
    "check:privacy": "node scripts/check-privacy.cjs",
    "test:watch": "vitest",
    "lint": "eslint src scripts vite.config.mjs eslint.config.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "devDependencies": {
    "ws": "^8.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
