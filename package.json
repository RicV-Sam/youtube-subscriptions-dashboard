    "@testing-library/user-event": "^14.6.7",
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vitest": "^5.0.2",
    "jsdom": "^27.4.0",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "axe-core": "^4.13.0"
